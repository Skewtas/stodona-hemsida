{
  "name": "stodona-hemsida",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "postbuild": "bun scripts/indexnow.mjs --if-vercel",
    "prerender": "vite build && node scripts/prerender.mjs",
    "build:ssg": "vite build && (playwright install chromium && node scripts/prerender.mjs || echo prerender_skipped) && bun scripts/indexnow.mjs --if-vercel",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": {
      "collapseWhitespace": false
    },
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "inlineCss": false,
    "include": [
      "/",
      "/hemstadning",
      "/flyttstadning",
      "/storstadning",
      "/fonsterputsning",
      "/foretagsstadning",
      "/byggstadning",
      "/trappstadning",
      "/priser",
      "/om-oss",
      "/kontakt",
      "/faq",
      "/recensioner",
      "/blogg"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/edge": "^1.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jszip": "^3.10.1",
    "playwright": "^1.62.1",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}